# Copia este archivo a .env.local y rellena los valores (nunca se commitean).

# URL absoluta del sitio, para canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL=https://marialunares.com

# Newsletter (Kit, antes ConvertKit). Se usan SOLO en /api/subscribe,
# nunca llegan al navegador. Las mismas variables van en Vercel
# (Settings -> Environment Variables) para Production y Preview.
KIT_API_KEY=
KIT_FORM_ID=
